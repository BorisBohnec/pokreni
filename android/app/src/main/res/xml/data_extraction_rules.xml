<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: the training log is small, so it goes into Google's automatic backup and phone-to-phone transfers. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
